\newlabel{eq:rango}{{1.52}{33}{La formula fondamentale di classificazione}{equation.1.4.52}{}}
\newlabel{eq:labilita}{{1.53}{33}{La formula fondamentale di classificazione}{equation.1.4.53}{}}
