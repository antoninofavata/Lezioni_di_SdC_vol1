\@writefile{lof}{\contentsline {figure}{\numberline {1.4}{\ignorespaces Interpretazione geometrica del termine rotazionale $\bm  {\upvartheta } \times \overrightarrow {OP}$: la componente $\overrightarrow {OP}_{\!\perp }$, ortogonale all'asse di rotazione, determina la distanza $d$ del punto $P$ dall'asse; lo spostamento rotazionale ha modulo $|\bm  {\upvartheta }|\,d$ ed è tangente alla circonferenza di raggio $d$.}}{16}{figure.caption.6}\protected@file@percent }
