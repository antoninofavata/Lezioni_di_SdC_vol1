\@writefile{lof}{\contentsline {figure}{\numberline {10.29}{\ignorespaces Caso (b), carico $p$ sul tratto centrale $DEF$ --- (a) schema e reazioni ($V_A=V_B=p\ell $, $H_A=H_B=6p\ell $); (b) sforzo normale $N$ (le bielle, scariche, portano $N$ uniforme: $N_{AC}=N_{BG}=+\tfrac  {\sqrt  5}{3}$, $N_{AD}=N_{BF}=-\tfrac  {4\sqrt  {17}}{3}$, in $p\ell $); (c) taglio $T$; (d) momento flettente $M$, dal lato delle fibre tese. Scale indipendenti; $M=0$ alle cerniere $C$, $E$, $G$ e ovunque non positivo (estradosso teso, lineare su $CD$, $FG$); $N$ e $M$ simmetrici rispetto a $E$, $T$ emisimmetrico.}}{278}{figure.caption.106}\protected@file@percent }
\newlabel{fig:stampella_NTM_b}{{10.29}{278}{Caso (b), carico $p$ sul tratto centrale $DEF$ --- (a) schema e reazioni ($V_A=V_B=p\ell $, $H_A=H_B=6p\ell $); (b) sforzo normale $N$ (le bielle, scariche, portano $N$ uniforme: $N_{AC}=N_{BG}=+\tfrac {\sqrt 5}{3}$, $N_{AD}=N_{BF}=-\tfrac {4\sqrt {17}}{3}$, in $p\ell $); (c) taglio $T$; (d) momento flettente $M$, dal lato delle fibre tese. Scale indipendenti; $M=0$ alle cerniere $C$, $E$, $G$ e ovunque non positivo (estradosso teso, lineare su $CD$, $FG$); $N$ e $M$ simmetrici rispetto a $E$, $T$ emisimmetrico}{figure.caption.106}{}}
