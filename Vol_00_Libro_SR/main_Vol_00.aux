\@writefile{lof}{\contentsline {figure}{\numberline {10.20}{\ignorespaces Ponte strallato: stato di sollecitazione. \emph  {(a)}~Carichi e reazioni esterne, con il tratteggio grigio della fibra di riferimento adottata per ciascuna asta; \emph  {(b)}~taglio, \emph  {(c)}~forza normale, \emph  {(d)}~momento flettente. In \emph  {(c)} l'impalcato di sinistra è a scala doppia, per renderlo leggibile accanto agli sforzi ben maggiori delle antenne; quello di destra è scarico. L'antenna $HG$ non compare in \emph  {(b)} e \emph  {(d)}, dove taglio e momento vi sono identicamente nulli.}}{261}{figure.caption.97}\protected@file@percent }
\newlabel{fig:strallato_NTM}{{10.20}{261}{Ponte strallato: stato di sollecitazione. \emph {(a)}~Carichi e reazioni esterne, con il tratteggio grigio della fibra di riferimento adottata per ciascuna asta; \emph {(b)}~taglio, \emph {(c)}~forza normale, \emph {(d)}~momento flettente. In \emph {(c)} l'impalcato di sinistra è a scala doppia, per renderlo leggibile accanto agli sforzi ben maggiori delle antenne; quello di destra è scarico. L'antenna $HG$ non compare in \emph {(b)} e \emph {(d)}, dove taglio e momento vi sono identicamente nulli}{figure.caption.97}{}}
