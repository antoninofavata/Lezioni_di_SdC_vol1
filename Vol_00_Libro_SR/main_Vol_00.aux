\@writefile{lof}{\contentsline {figure}{\numberline {8.5}{\ignorespaces Il meccanismo usato per determinare $Y_B$: si sopprime il carrello in $B$. $\mathcal  {C}_1$ ruota di $\vartheta _1$ attorno alla cerniera in $A$; $\mathcal  {C}_2$ accompagna il moto ruotando di $\vartheta _2=-\tfrac  32\vartheta _1$ attorno a $C$, in modo da lasciare fermo il punto $D$, dove il carrello non è stato toccato.}}{166}{figure.caption.62}\protected@file@percent }
\newlabel{fig:gerber_mecc_B}{{8.5}{166}{Il meccanismo usato per determinare $Y_B$: si sopprime il carrello in $B$. $\mathcal {C}_1$ ruota di $\vartheta _1$ attorno alla cerniera in $A$; $\mathcal {C}_2$ accompagna il moto ruotando di $\vartheta _2=-\tfrac 32\vartheta _1$ attorno a $C$, in modo da lasciare fermo il punto $D$, dove il carrello non è stato toccato}{figure.caption.62}{}}
