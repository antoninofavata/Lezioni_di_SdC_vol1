\@writefile{lof}{\contentsline {figure}{\numberline {1.4}{\ignorespaces Il meccanismo usato per determinare $Y_D$: si sopprime (concettualmente) il carrello in $D$, in grigio nella sua posizione originaria. Cerniera in $A$ e carrello in $B$ bloccano $\mathcal  {C}_1$, che resta fermo; $\mathcal  {C}_2$ è allora libero di ruotare, di un angolo virtuale $\vartheta _2$, attorno al punto fisso $C$. Solo $F$ e la reazione incognita $Y_D$ compiono lavoro in questo moto.}}{19}{figure.caption.6}\protected@file@percent }
\newlabel{fig:gerber_mecc_D}{{1.4}{19}{Il meccanismo usato per determinare $Y_D$: si sopprime (concettualmente) il carrello in $D$, in grigio nella sua posizione originaria. Cerniera in $A$ e carrello in $B$ bloccano $\mathcal {C}_1$, che resta fermo; $\mathcal {C}_2$ è allora libero di ruotare, di un angolo virtuale $\vartheta _2$, attorno al punto fisso $C$. Solo $F$ e la reazione incognita $Y_D$ compiono lavoro in questo moto}{figure.caption.6}{}}
\newlabel{eq:sopp_YB}{{1.30}{19}{Soppesare le reazioni: la via del lavoro virtuale}{equation.1.3.30}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.5}{\ignorespaces Il meccanismo usato per determinare $Y_B$: si sopprime il carrello in $B$. $\mathcal  {C}_1$ ruota di $\vartheta _1$ attorno alla cerniera in $A$; $\mathcal  {C}_2$ accompagna il moto ruotando di $\vartheta _2=-\tfrac  32\vartheta _1$ attorno a $C$, in modo da lasciare fermo il punto $D$, dove il carrello non è stato toccato.}}{20}{figure.caption.7}\protected@file@percent }
\newlabel{fig:gerber_mecc_B}{{1.5}{20}{Il meccanismo usato per determinare $Y_B$: si sopprime il carrello in $B$. $\mathcal {C}_1$ ruota di $\vartheta _1$ attorno alla cerniera in $A$; $\mathcal {C}_2$ accompagna il moto ruotando di $\vartheta _2=-\tfrac 32\vartheta _1$ attorno a $C$, in modo da lasciare fermo il punto $D$, dove il carrello non è stato toccato}{figure.caption.7}{}}
