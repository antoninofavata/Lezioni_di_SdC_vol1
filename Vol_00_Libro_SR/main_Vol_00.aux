\@writefile{lof}{\contentsline {figure}{\numberline {2.6}{\ignorespaces Sistemi di forze concentrate $-F_k\,\mathbf  {a}_y$ equiorientate su un intervallo di lunghezza $\ell $: la risultante (in grigio) è applicata nel baricentro dei punti di applicazione pesati con le rispettive intensità. \textbf  {\textit  {(a)}}~$|\mathbf  {f}|=2F$, $d=\ell /2$. \textbf  {\textit  {(b)}}~$|\mathbf  {f}|=3F$, $d=5\ell /9$. \textbf  {\textit  {(c)}}~$|\mathbf  {f}|=3F$, $d=\ell /2$.}}{50}{figure.caption.21}\protected@file@percent }
