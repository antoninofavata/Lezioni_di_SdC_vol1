\@writefile{lof}{\contentsline {figure}{\numberline {3.9}{\ignorespaces Trave Gerber elementare ($n_c=2$, $m=6$, $\nu =0$): corpo \emph  {portante}~$\mathcal  {C}_1$ (cerniera in~$A$, carrello in~$B$, $m_1=3$, $\nu _1=0$) e corpo \emph  {appendice}~$\mathcal  {C}_2$ (cerniera interna in~$C$, carrello in~$D$, $m_2=3$, $\nu _2=0$ una volta fissato~$\mathcal  {C}_1$). La collinearità di $A$, $B$, $C$, $D$ sulla stessa retta \emph  {non} costituisce degenerazione: la dipendenza tra i corpi è \emph  {sequenziale} (non reciproca).}}{126}{figure.caption.42}\protected@file@percent }
