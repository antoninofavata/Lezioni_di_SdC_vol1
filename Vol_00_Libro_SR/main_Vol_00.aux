\@writefile{toc}{\contentsline {subsubsection}{Il traliccio di Ritter-M\"{o}rsch come travatura di Warren}{337}{equation.11.8.20}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11.17}{\ignorespaces Traliccio di Ritter-M\"{o}rsch con carichi $P$ applicati ai nodi del corrente superiore ($F$, $G$, $H$, $I$) e reazioni $2P$ agli appoggi $A$ ed $E$. Le quote orizzontali indicano le proiezioni delle diagonali: $b = \cot \vartheta $ per i puntoni (tratto spesso, compressi) e $a = \cot \alpha $ per le staffe (tratto sottile, tese). Il diagramma del taglio è positivo nella metà sinistra ($2P$ nel primo pannello, $P$ nel secondo) e nullo tra i nodi $G$ e $H$; per antisimmetria è negativo nella metà destra. Il poligono del momento ha tetto piatto di valore $(a+3b)P$ tra $G$ e $H$, dove il taglio è nullo, e valori nodali $(a+2b)P$ in $B$ e $D$, $2bP$ in $F$ e $I$.}}{338}{figure.caption.132}\protected@file@percent }
\newlabel{fig:traliccio_Morsch}{{11.17}{338}{Traliccio di Ritter-M\"{o}rsch con carichi $P$ applicati ai nodi del corrente superiore ($F$, $G$, $H$, $I$) e reazioni $2P$ agli appoggi $A$ ed $E$. Le quote orizzontali indicano le proiezioni delle diagonali: $b = \cot \vartheta $ per i puntoni (tratto spesso, compressi) e $a = \cot \alpha $ per le staffe (tratto sottile, tese). Il diagramma del taglio è positivo nella metà sinistra ($2P$ nel primo pannello, $P$ nel secondo) e nullo tra i nodi $G$ e $H$; per antisimmetria è negativo nella metà destra. Il poligono del momento ha tetto piatto di valore $(a+3b)P$ tra $G$ e $H$, dove il taglio è nullo, e valori nodali $(a+2b)P$ in $B$ e $D$, $2bP$ in $F$ e $I$}{figure.caption.132}{}}
\newlabel{eq:triangolo_forze}{{11.21}{339}{Il traliccio di Ritter-M\"{o}rsch come travatura di Warren}{equation.11.8.21}{}}
\newlabel{eq:Np_Ns}{{11.22}{339}{Il traliccio di Ritter-M\"{o}rsch come travatura di Warren}{equation.11.8.22}{}}
\newlabel{eq:Np_Ns_vert}{{11.23}{339}{Il traliccio di Ritter-M\"{o}rsch come travatura di Warren}{equation.11.8.23}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11.18}{\ignorespaces Maglia elementare del traliccio di Ritter-Mörsch e poligono delle forze al nodo del corrente superiore. \emph  {Pannello sinistro}: la variazione di sforzo $\Delta N$ nei correnti --- uguale in valore assoluto nel corrente superiore compresso e in quello inferiore teso --- deve essere equilibrata dalle componenti orizzontali del puntone (tratto spesso, angolo $\vartheta $) e della staffa (tratto sottile, angolo $\alpha $). \emph  {Pannello destro}: poligono chiuso delle forze al nodo; l'angolo al vertice opposto a $\Delta N$ vale $\pi - (\vartheta +\alpha )$, donde per il teorema dei seni le~\eqref  {eq:Np_Ns}.}}{339}{figure.caption.133}\protected@file@percent }
\newlabel{fig:maglia_Morsch}{{11.18}{339}{Maglia elementare del traliccio di Ritter-Mörsch e poligono delle forze al nodo del corrente superiore. \emph {Pannello sinistro}: la variazione di sforzo $\Delta N$ nei correnti --- uguale in valore assoluto nel corrente superiore compresso e in quello inferiore teso --- deve essere equilibrata dalle componenti orizzontali del puntone (tratto spesso, angolo $\vartheta $) e della staffa (tratto sottile, angolo $\alpha $). \emph {Pannello destro}: poligono chiuso delle forze al nodo; l'angolo al vertice opposto a $\Delta N$ vale $\pi - (\vartheta +\alpha )$, donde per il teorema dei seni le~\eqref {eq:Np_Ns}}{figure.caption.133}{}}
