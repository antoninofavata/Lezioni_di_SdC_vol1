\@writefile{lof}{\contentsline {figure}{\numberline {10.28}{\ignorespaces Caso (a), carico $p$ su tutta la travata $CDEFG$ --- (a) schema e reazioni; (b) sforzo normale $N$ sulle travi (le bielle, scariche, portano $N$ uniforme: $N_{AC}=N_{BG}=-\tfrac  {5\sqrt  5}{12}$, $N_{AD}=N_{BF}=-\tfrac  {25\sqrt  {17}}{12}$, in $p\ell $); (c) taglio $T$; (d) momento flettente $M$, dal lato delle fibre tese. Scale indipendenti; $M=0$ alle cerniere $C$, $E$, $G$; i diagrammi $N$ e $M$ simmetrici rispetto a $E$, quello di $T$ è emisimmetrico.}}{277}{figure.caption.105}\protected@file@percent }
