\@writefile{toc}{\contentsline {paragraph}{Classificazione e riconoscimenti preliminari.}{253}{figure.caption.91}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10.14}{\ignorespaces Ponte strallato: schema strutturale, simmetrico rispetto alla verticale per~$E$. Le antenne $BC$ e $HG$ sono continue attraverso $D$ ed $F$: la mezzaluna indica che a incernierarsi all'antenna è l'impalcato, mentre il montante prosegue senza interruzione. Le ritenute $AC$ ed $LG$ e gli stralli $CE$ e $GE$ convergono con l'antenna nelle cerniere triple $C$ e $G$; in $E$ si incontrano i due stralli e i due semi-impalcati in una cerniera quadrupla. I vincoli esterni sono le cerniere di ancoraggio in $A$ e in $L$ e due carrelli ad asse verticale in $B$ e in $H$.}}{254}{figure.caption.91}\protected@file@percent }
\newlabel{fig:strallato_schema}{{10.14}{254}{Ponte strallato: schema strutturale, simmetrico rispetto alla verticale per~$E$. Le antenne $BC$ e $HG$ sono continue attraverso $D$ ed $F$: la mezzaluna indica che a incernierarsi all'antenna è l'impalcato, mentre il montante prosegue senza interruzione. Le ritenute $AC$ ed $LG$ e gli stralli $CE$ e $GE$ convergono con l'antenna nelle cerniere triple $C$ e $G$; in $E$ si incontrano i due stralli e i due semi-impalcati in una cerniera quadrupla. I vincoli esterni sono le cerniere di ancoraggio in $A$ e in $L$ e due carrelli ad asse verticale in $B$ e in $H$}{figure.caption.91}{}}
\@writefile{toc}{\contentsline {paragraph}{Passo 1 --- Scelta della partizione e reazioni vincolari esterne.}{255}{ossinner.10.23}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Passo 2 --- Ordine di risoluzione e azioni alle connessioni.}{255}{figure.caption.92}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10.15}{\ignorespaces La partizione adottata. Ogni corpo è staccato lungo il proprio asse, così che i vuoti si aprano dove sono i collegamenti e la maglia resti riconoscibile; i cerchietti maggiorati in $C$, in $E$ e in $G$ sono i tre nodi isolati come corpi liberi autonomi, mentre in $D$ e in $F$ la connessione resta un vincolo interno. Le frecce rappresentano forze scambiate ai nodi, non caratteristiche della sollecitazione. A tratto pieno le sei incognite primarie: una per ciascuna biella, che ne trasmette il valore inalterato da un estremo all'altro, e le due reazioni dei carrelli. A tratto sottile le forze alle interfacce fra antenne e impalcati, che pure esistono ma discendono dalle prime. I carichi applicati sono quelli della Fig.~\ref {fig:strallato_schema}.}}{256}{figure.caption.92}\protected@file@percent }
\newlabel{fig:strallato_esploso}{{10.15}{256}{La partizione adottata. Ogni corpo è staccato lungo il proprio asse, così che i vuoti si aprano dove sono i collegamenti e la maglia resti riconoscibile; i cerchietti maggiorati in $C$, in $E$ e in $G$ sono i tre nodi isolati come corpi liberi autonomi, mentre in $D$ e in $F$ la connessione resta un vincolo interno. Le frecce rappresentano forze scambiate ai nodi, non caratteristiche della sollecitazione. A tratto pieno le sei incognite primarie: una per ciascuna biella, che ne trasmette il valore inalterato da un estremo all'altro, e le due reazioni dei carrelli. A tratto sottile le forze alle interfacce fra antenne e impalcati, che pure esistono ma discendono dalle prime. I carichi applicati sono quelli della \FIGref {fig:strallato_schema}}{figure.caption.92}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10.16}{\ignorespaces Corpo libero del semi-impalcato $DE$: una trave appoggiata a due cerniere, di luce $2\ell $, sotto il carico uniforme $p$. L'equilibrio alla rotazione attorno a $D$ determina $Y_{ED}$, e quello alla traslazione verticale $Y_D$; le componenti orizzontali restano incognite e opposte.}}{256}{figure.caption.93}\protected@file@percent }
\newlabel{fig:strallato_cdl_DE}{{10.16}{256}{Corpo libero del semi-impalcato $DE$: una trave appoggiata a due cerniere, di luce $2\ell $, sotto il carico uniforme $p$. L'equilibrio alla rotazione attorno a $D$ determina $Y_{ED}$, e quello alla traslazione verticale $Y_D$; le componenti orizzontali restano incognite e opposte}{figure.caption.93}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10.17}{\ignorespaces Corpo libero dell'antenna $BC$. \emph  {(a)}~Le forze agenti prima dell'equilibrio: tutte giacciono sulla verticale dell'asse, sicché l'equilibrio alla rotazione attorno a $B$ coinvolge le sole componenti orizzontali. \emph  {(b)}~Dopo l'equilibrio restano due sole incognite, $Y_B$ e $Y_C$, entrambe verticali e allineate: l'ultima equazione cardinale non basta a determinarle, e occorre attendere il nodo $C$.}}{257}{figure.caption.94}\protected@file@percent }
\newlabel{fig:strallato_cdl_BC}{{10.17}{257}{Corpo libero dell'antenna $BC$. \emph {(a)}~Le forze agenti prima dell'equilibrio: tutte giacciono sulla verticale dell'asse, sicché l'equilibrio alla rotazione attorno a $B$ coinvolge le sole componenti orizzontali. \emph {(b)}~Dopo l'equilibrio restano due sole incognite, $Y_B$ e $Y_C$, entrambe verticali e allineate: l'ultima equazione cardinale non basta a determinarle, e occorre attendere il nodo $C$}{figure.caption.94}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10.18}{\ignorespaces Il nodo $C$ come corpo libero. Tutte le forze sono applicate nel nodo e giacciono sulla propria retta d'azione; i rettangoli tratteggiati scompongono nelle componenti gli sforzi assiali delle due bielle. Poiché l'antenna non riceve dal nodo alcuna forza orizzontale, le due componenti orizzontali si fanno equilibrio fra loro e le verticali si sommano scaricandosi sull'antenna.}}{258}{figure.caption.95}\protected@file@percent }
\newlabel{fig:strallato_nodo_C}{{10.18}{258}{Il nodo $C$ come corpo libero. Tutte le forze sono applicate nel nodo e giacciono sulla propria retta d'azione; i rettangoli tratteggiati scompongono nelle componenti gli sforzi assiali delle due bielle. Poiché l'antenna non riceve dal nodo alcuna forza orizzontale, le due componenti orizzontali si fanno equilibrio fra loro e le verticali si sommano scaricandosi sull'antenna}{figure.caption.95}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10.19}{\ignorespaces Il nodo $E$ come corpo libero. \emph  {(a)}~Le incognite e, a tratto grigio, le azioni già note trasmesse dai due semi-impalcati. \emph  {(b)}~L'esito del calcolo: le componenti verticali dei due stralli, $\tfrac  54 p\ell $ e $\tfrac  34 p\ell $, bilanciano i $2p\ell $ ricevuti dagli impalcati, e le orizzontali bilanciano la spinta $p\ell $ dell'impalcato di sinistra. La verifica si legge sulla figura.}}{259}{figure.caption.96}\protected@file@percent }
\newlabel{fig:strallato_nodo_E}{{10.19}{259}{Il nodo $E$ come corpo libero. \emph {(a)}~Le incognite e, a tratto grigio, le azioni già note trasmesse dai due semi-impalcati. \emph {(b)}~L'esito del calcolo: le componenti verticali dei due stralli, $\tfrac 54 p\ell $ e $\tfrac 34 p\ell $, bilanciano i $2p\ell $ ricevuti dagli impalcati, e le orizzontali bilanciano la spinta $p\ell $ dell'impalcato di sinistra. La verifica si legge sulla figura}{figure.caption.96}{}}
