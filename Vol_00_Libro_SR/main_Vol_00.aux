\@writefile{lof}{\contentsline {figure}{\numberline {5.3}{\ignorespaces \textbf  {\textit  {(a)}}~Rappresentazione geometrica di una traslazione e di una rotazione finita nel piano, dove il punto $O$ si sposta in $O_*$ e il punto $P$ si sposta in $P_*$, con origine del sistema di riferimento in $\Omega $. Il vettore $\mathbf  {u}(O)$ rappresenta la traslazione di $O$, mentre $\mathbf  {u}(P)$ è lo spostamento totale di $P$, e $\mathbf  {R}\overrightarrow {OP}$ è il vettore $\overrightarrow {OP}$ ruotato di $\vartheta $. \textbf  {\textit  {(b)}}~Scomposizione dello spostamento del punto $P$ in $P_*$ come somma della traslazione $\mathbf  {u}(O)$ e della rotazione, con la componente rotazionale decomposta nelle direzioni ortogonale ($|\overrightarrow {OP}|\sin \vartheta $) e parallela ($|\overrightarrow {OP}|(1-\cos \vartheta )$) rispetto al vettore posizione $\overrightarrow {OP}$.}}{74}{figure.caption.23}\protected@file@percent }
\newlabel{fig:spostamenti_finiti}{{5.3}{74}{\textbf {\textit {(a)}}~Rappresentazione geometrica di una traslazione e di una rotazione finita nel piano, dove il punto $O$ si sposta in $O_*$ e il punto $P$ si sposta in $P_*$, con origine del sistema di riferimento in $\Omega $. Il vettore $\ub (O)$ rappresenta la traslazione di $O$, mentre $\ub (P)$ è lo spostamento totale di $P$, e $\Rbb \protect \overrightarrow {OP}$ è il vettore $\protect \overrightarrow {OP}$ ruotato di $\vartheta $. \textbf {\textit {(b)}}~Scomposizione dello spostamento del punto $P$ in $P_*$ come somma della traslazione $\ub (O)$ e della rotazione, con la componente rotazionale decomposta nelle direzioni ortogonale ($|\protect \overrightarrow {OP}|\sin \vartheta $) e parallela ($|\protect \overrightarrow {OP}|(1-\cos \vartheta )$) rispetto al vettore posizione $\protect \overrightarrow {OP}$}{figure.caption.23}{}}
