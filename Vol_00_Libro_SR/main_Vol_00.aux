\@writefile{toc}{\contentsline {subsection}{\numberline {4.4.2}Asse centrale del sistema di forze}{73}{subsection.4.4.2}\protected@file@percent }
\newlabel{eq:asse_centrale_forze}{{4.25}{73}{Asse centrale del sistema di forze}{equation.4.4.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces Costruzione geometrica dell'asse centrale del sistema di forze. Il momento rispetto a $O$ si decompone nella componente $\bm  {\upmu }^O_{\parallel }$, parallela a $\mathbf  {r}$ e invariante per tutti i poli, e nella componente $\bm  {\upmu }^O_{\perp }$, giacente nel piano $\pi $ ortogonale a $\mathbf  {r}$. Il punto $C_\perp $, intersezione dell'asse centrale con $\pi $, è determinato dalla condizione $\mathbf  {r}\times \overrightarrow {OC_\perp } = -\bm  {\upmu }^O_{\perp }$; l'asse centrale è la retta per $C_\perp $ parallela a $\mathbf  {r}$.}}{73}{figure.caption.30}\protected@file@percent }
\newlabel{f:asse_centrale_forze}{{4.2}{73}{Costruzione geometrica dell'asse centrale del sistema di forze. Il momento rispetto a $O$ si decompone nella componente $\bm {\upmu }^O_{\parallel }$, parallela a $\rb $ e invariante per tutti i poli, e nella componente $\bm {\upmu }^O_{\perp }$, giacente nel piano $\pi $ ortogonale a $\rb $. Il punto $C_\perp $, intersezione dell'asse centrale con $\pi $, è determinato dalla condizione $\rb \times \protect \overrightarrow {OC_\perp } = -\bm {\upmu }^O_{\perp }$; l'asse centrale è la retta per $C_\perp $ parallela a $\rb $}{figure.caption.30}{}}
\newlabel{eq:asse_centrale_algebrica_F}{{4.26}{74}{}{equation.4.4.26}{}}
