\@writefile{lof}{\contentsline {figure}{\numberline {6.3}{\ignorespaces Centro di riduzione nel caso piano. Il sistema equivalente a una forza $\mathbf  {f}$ applicata in $O$ con momento risultante $\mu _z(O)$ si riduce alla sola forza $\mathbf  {f}$ applicata nel punto $C$ della perpendicolare a $\mathbf  {f}$ passante per $O$, a distanza $|\overrightarrow {OC}| = |\mu _z(O)|/|\mathbf  {f}|$. Al tendere di $|\mathbf  {f}|\to 0$ a parità di $\mu _z(O)$ il centro si allontana all'infinito: una coppia pura non ammette centro di riduzione.}}{113}{figure.caption.36}\protected@file@percent }
\newlabel{fig:asse_sollecitazione}{{6.3}{113}{Centro di riduzione\index {centro di riduzione|seealso{asse di sollecitazione}} nel caso piano. Il sistema equivalente a una forza $\fb $ applicata in $O$ con momento risultante $\mu _z(O)$ si riduce alla sola forza $\fb $ applicata nel punto $C$ della perpendicolare a $\fb $ passante per $O$, a distanza $|\protect \overrightarrow {OC}| = |\mu _z(O)|/|\fb |$. Al tendere di $|\fb |\to 0$ a parità di $\mu _z(O)$ il centro si allontana all'infinito: una coppia pura non ammette centro di riduzione}{figure.caption.36}{}}
\newlabel{eq:CdR_coord}{{6.30}{114}{Particolarizzazione al caso piano}{equation.6.4.30}{}}
\newlabel{eq:momento_da_CdR}{{6.31}{114}{Particolarizzazione al caso piano}{equation.6.4.31}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.4.3}Equivalenza di sistemi di forze}{114}{subsection.6.4.3}\protected@file@percent }
\newlabel{sec:equivalenza}{{6.4.3}{114}{Equivalenza di sistemi di forze}{subsection.6.4.3}{}}
\newlabel{eq:def_equivalenza}{{6.32}{114}{Equivalenza di sistemi di forze}{equation.6.4.32}{}}
\@writefile{toc}{\contentsline {paragraph}{Operazioni elementari di equivalenza.}{115}{ossinner.6.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6.4}{\ignorespaces Operazioni elementari di equivalenza (I). \textbf  {\textit  {(a)}}~Traslazione della forza $\mathbf  {f}_k$ lungo la propria linea d'azione da $P_k$ a $P_k'$: risultante e momento risultante restano invariati. \textbf  {\textit  {(b)}}~Composizione di due forze concorrenti in $P$: il sistema è equivalente alla risultante $\mathbf  {f}_1+\mathbf  {f}_2$ applicata in $P$. \textbf  {\textit  {(c)}}~Decomposizione della forza $\mathbf  {f}$ applicata in $P$ nelle componenti $\mathbf  {f}_1$ e $\mathbf  {f}_2$ secondo due direzioni indipendenti: operazione inversa alla composizione.}}{115}{figure.caption.37}\protected@file@percent }
\newlabel{fig:operazioni_elementari_1}{{6.4}{115}{Operazioni elementari di equivalenza (I). \textbf {\textit {(a)}}~Traslazione della forza $\fb _k$ lungo la propria linea d'azione da $P_k$ a $P_k'$: risultante e momento risultante restano invariati. \textbf {\textit {(b)}}~Composizione di due forze concorrenti in $P$: il sistema è equivalente alla risultante $\fb _1+\fb _2$ applicata in $P$. \textbf {\textit {(c)}}~Decomposizione della forza $\fb $ applicata in $P$ nelle componenti $\fb _1$ e $\fb _2$ secondo due direzioni indipendenti: operazione inversa alla composizione}{figure.caption.37}{}}
\@writefile{toc}{\contentsline {paragraph}{Aggiunta o rimozione di un sistema equilibrato.}{116}{figure.caption.37}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6.5}{\ignorespaces Trasporto di una forza in un punto non appartenente alla linea d'azione. \textbf  {\textit  {(a)}}~Sistema originale: forza $\mathbf  {f}$ applicata in $P$. \textbf  {\textit  {(b)}}~Aggiunta in $Q$ della coppia equilibrata $(\mathbf  {f},\,-\mathbf  {f})$: la forza $(P,\,\mathbf  {f})$ e $(Q,\,-\mathbf  {f})$ formano una coppia di momento $\bm  {\upmu } = \overrightarrow {QP}\times \mathbf  {f}$, con braccio $b$. \textbf  {\textit  {(c)}}~Sistema equivalente: forza $\mathbf  {f}$ applicata in $Q$ più la coppia correttiva oraria di intensità $\mu (Q) = |\mathbf  {f}|\,b$.}}{116}{figure.caption.38}\protected@file@percent }
\newlabel{fig:trasporto_forza}{{6.5}{116}{Trasporto di una forza in un punto non appartenente alla linea d'azione. \textbf {\textit {(a)}}~Sistema originale: forza $\fb $ applicata in $P$. \textbf {\textit {(b)}}~Aggiunta in $Q$ della coppia equilibrata $(\fb ,\,-\fb )$: la forza $(P,\,\fb )$ e $(Q,\,-\fb )$ formano una coppia di momento $\bm {\upmu } = \protect \overrightarrow {QP}\times \fb $, con braccio $b$. \textbf {\textit {(c)}}~Sistema equivalente: forza $\fb $ applicata in $Q$ più la coppia correttiva oraria di intensità $\mu (Q) = |\fb |\,b$}{figure.caption.38}{}}
