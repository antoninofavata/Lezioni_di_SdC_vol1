\newlabel{eq:compat_via_im}{{8.51}{178}{Struttura duale dei due problemi}{equation.8.4.51}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8.7}{\ignorespaces Struttura duale dei problemi cinematico $\bm  {A}\bm  {u} = \bm  {s}$ e statico $\bm  {A}^\top \bm  {r} = -\bm  {f}$. Il problema cinematico ammette soluzione se e solo se $\bm  {s}_c \in \mathcal  {I}(\bm  {A})$, cioè $\bm  {s}_n = \bm  {0}$: il cedimento deve essere cinematicamente ammissibile. Il problema statico ammette soluzione se e solo se $\bm  {f}_c \in \mathcal  {I}(\bm  {A}^\top )$, cioè $\bm  {f}_n = \bm  {0}$: la forza attiva deve essere equilibrabile dai vincoli. Le soluzioni generali sono $\bm  {u} = \bm  {u}_c + \bm  {u}_n$ con $\bm  {u}_n \in \mathcal  {N}(\bm  {A})$ (meccanismo) arbitrario, e $\bm  {r} = \bm  {r}_c + \bm  {r}_n$ con $\bm  {r}_n \in \mathcal  {N}(\bm  {A}^\top )$ (stato di autoequilibrio) arbitrario.}}{178}{figure.caption.64}\protected@file@percent }
\newlabel{fig:problemi_duali_SCR}{{8.7}{178}{Struttura duale dei problemi cinematico $\bm {A}\bm {u} = \bm {s}$ e statico $\bm {A}^\top \bm {r} = -\bm {f}$. Il problema cinematico ammette soluzione se e solo se $\bm {s}_c \in \Ic (\bm {A})$, cioè $\bm {s}_n = \bm {0}$: il cedimento deve essere cinematicamente ammissibile. Il problema statico ammette soluzione se e solo se $\bm {f}_c \in \Ic (\bm {A}^\top )$, cioè $\bm {f}_n = \bm {0}$: la forza attiva deve essere equilibrabile dai vincoli. Le soluzioni generali sono $\bm {u} = \bm {u}_c + \bm {u}_n$ con $\bm {u}_n \in \Nc (\bm {A})$ (meccanismo) arbitrario, e $\bm {r} = \bm {r}_c + \bm {r}_n$ con $\bm {r}_n \in \Nc (\bm {A}^\top )$ (stato di autoequilibrio) arbitrario}{figure.caption.64}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8.2}{\ignorespaces Sintesi dei quattro sottospazi fondamentali di $\bm  {A}$ e del loro significato meccanico. I due sottospazi di $\mathbb  {R}^{n}$ sono ortogonali ($\mathcal  {N}(\bm  {A}) \perp \mathcal  {I}(\bm  {A}^{\top })$); idem per i due di $\mathbb  {R}^{m}$ ($\mathcal  {N}(\bm  {A}^\top ) \perp \mathcal  {I}(\bm  {A})$).}}{179}{table.caption.65}\protected@file@percent }
\newlabel{tab:quattro_sottospazi}{{8.2}{179}{Sintesi dei quattro sottospazi fondamentali di $\bm {A}$ e del loro significato meccanico. I due sottospazi di $\mathbb {R}^{n}$ sono ortogonali ($\Nc (\bm {A}) \perp \Ic (\bm {A}^{\top })$); idem per i due di $\mathbb {R}^{m}$ ($\Nc (\bm {A}^\top ) \perp \Ic (\bm {A})$)}{table.caption.65}{}}
